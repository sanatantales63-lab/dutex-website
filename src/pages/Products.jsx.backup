          marginTop: '60px', background: 'linear-gradient(135deg, var(--primary) 0%, #3a4a2a 100%)',
          borderRadius: '20px', padding: '40px 36px', color: 'white',
          display: 'flex', flexWrap: 'wrap', justifyContent: 'space-between', alignItems: 'center', gap: '20px'
        }}>
          <div>
            <h3 style={{ fontSize: '22px', fontWeight: '800', marginBottom: '6px' }}>Need Help Choosing the Right Paint?</h3>
            <p style={{ opacity: 0.85, fontSize: '14px' }}>Our experts will guide you to the perfect product for your wall & budget.</p>
          </div>
          <div style={{ display: 'flex', gap: '12px', flexWrap: 'wrap' }}>
            <a href="tel:+917225020180" className="enquire-btn" style={{
              display: 'flex', alignItems: 'center', gap: '8px',
              backgroundColor: 'white', color: 'var(--primary)',
              padding: '12px 22px', borderRadius: '10px', fontWeight: '700', fontSize: '14px',
              textDecoration: 'none'
            }}>
              <Phone size={16} /> Call Now
            </a>
            <a href="https://wa.me/917225020180" target="_blank" rel="noreferrer" className="enquire-btn" style={{
              display: 'flex', alignItems: 'center', gap: '8px',
              backgroundColor: '#25D366', color: 'white',
              padding: '12px 22px', borderRadius: '10px', fontWeight: '700', fontSize: '14px',
              textDecoration: 'none'
            }}>
              <MessageCircle size={16} /> WhatsApp Us
            </a>
          </div>
        </div>

      </div>

      {/* PRODUCT DETAIL MODAL */}
      {selectedProduct && createPortal(
        <div
          onClick={() => setSelectedProduct(null)}
          style={{
            position: 'fixed', top: 0, left: 0, right: 0, bottom: 0,
            backgroundColor: 'rgba(0,0,0,0.75)', display: 'flex',
            alignItems: 'center', justifyContent: 'center',
            zIndex: 999999, padding: '20px', backdropFilter: 'blur(6px)'
          }}
        >
          <div
            className="modal-animate modal-grid-inner"
            onClick={e => e.stopPropagation()}
            style={{
              backgroundColor: 'var(--bg-white)', width: '100%', maxWidth: '780px',
              maxHeight: '90vh', overflowY: 'auto', borderRadius: '20px',
              boxShadow: '0 24px 80px rgba(0,0,0,0.4)', position: 'relative',
              display: 'grid', gridTemplateColumns: '1fr 1.3fr',
              border: '1px solid var(--border-color)'
            }}
          >
            {/* Close Button */}
            <button 
              onClick={() => setSelectedProduct(null)} 
              aria-label="Close modal"
              style={{
                position: 'absolute', top: '16px', right: '16px', zIndex: 100,
                width: '38px', height: '38px', borderRadius: '50%',
                backgroundColor: 'rgba(0,0,0,0.12)', border: '1px solid rgba(0,0,0,0.1)', cursor: 'pointer',
                display: 'flex', alignItems: 'center', justifyContent: 'center', color: 'var(--text-dark)',
                transition: 'all 0.2s ease'
              }}
            >
              <X size={20} />
            </button>

            {/* Left: Image */}
            <div style={{ backgroundColor: '#f5f7fa', display: 'flex', flexDirection: 'column' }}>
              <div className="modal-img" style={{ height: '280px', display: 'flex', alignItems: 'center', justifyContent: 'center', padding: '20px' }}>
                <img src={selectedProduct.image} alt={selectedProduct.name}
                  style={{ maxHeight: '100%', maxWidth: '100%', objectFit: 'contain', filter: 'drop-shadow(0 8px 24px rgba(0,0,0,0.15))' }} />
              </div>
              <div style={{ padding: '20px', borderTop: '1px solid var(--border-color)' }}>
                <span style={{ fontSize: '11px', fontWeight: '700', textTransform: 'uppercase', color: rangeColor, letterSpacing: '1px', display: 'block', marginBottom: '10px' }}>
                  Packaging Sizes
                </span>
                <div style={{ display: 'flex', flexWrap: 'wrap', gap: '8px' }}>
                  {selectedProduct.sizes.map((sz, i) => (
                    <span key={i} style={{
                      backgroundColor: 'white', border: `2px solid ${rangeColor}`,
                      color: rangeColor, padding: '5px 12px', borderRadius: '20px',
                      fontSize: '12px', fontWeight: '700'
                    }}>{sz}</span>
                  ))}
                </div>
                <div style={{ marginTop: '16px', padding: '12px', backgroundColor: 'white', borderRadius: '10px', borderLeft: `4px solid ${rangeColor}` }}>
                  <span style={{ fontSize: '11px', fontWeight: '700', color: rangeColor, textTransform: 'uppercase', letterSpacing: '0.5px' }}>Coverage</span>
                  <p style={{ fontSize: '13px', marginTop: '4px', fontWeight: '600', color: 'var(--text-dark)' }}>{selectedProduct.coverage}</p>
                </div>
              </div>
            </div>

            {/* Right: Info */}
            <div style={{ padding: '32px 28px', display: 'flex', flexDirection: 'column' }}>
              <span style={{ fontSize: '11px', fontWeight: '800', textTransform: 'uppercase', letterSpacing: '1.5px', color: rangeColor, display: 'block', marginBottom: '6px' }}>
                {selectedProduct.range} Range • {selectedProduct.category}
              </span>
              <h2 style={{ fontSize: '22px', fontWeight: '800', marginBottom: '12px', color: 'var(--text-dark)', lineHeight: '1.2' }}>
                {selectedProduct.name}
              </h2>
              <p style={{ color: 'var(--text-muted)', fontSize: '13.5px', lineHeight: '1.65', marginBottom: '20px' }}>
                {selectedProduct.desc}
              </p>

              <h4 style={{ fontSize: '12px', textTransform: 'uppercase', letterSpacing: '1px', marginBottom: '10px', color: 'var(--text-dark)', fontWeight: '700' }}>
                Key Features
              </h4>
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px', marginBottom: '20px' }}>
                {selectedProduct.features.map((feat, i) => (
                  <div key={i} style={{ display: 'flex', alignItems: 'center', gap: '8px', padding: '8px 10px', backgroundColor: 'var(--bg-primary)', borderRadius: '8px' }}>
                    <div style={{ width: '18px', height: '18px', borderRadius: '50%', backgroundColor: rangeColor, display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                      <Check size={11} color="white" />
                    </div>
                    <span style={{ fontSize: '12px', fontWeight: '500', color: 'var(--text-dark)' }}>{feat}</span>
                  </div>
                ))}
              </div>

              <div style={{ padding: '14px', background: 'var(--bg-primary)', borderRadius: '10px', borderLeft: `4px solid ${rangeColor}`, marginBottom: '20px' }}>
                <strong style={{ fontSize: '11px', textTransform: 'uppercase', letterSpacing: '0.5px', color: rangeColor, display: 'block', marginBottom: '4px' }}>Application Method</strong>
                <p style={{ fontSize: '12.5px', color: 'var(--text-muted)', lineHeight: '1.5' }}>{selectedProduct.application}</p>
              </div>

              <div style={{ display: 'flex', gap: '10px', marginTop: 'auto' }}>
                <a
                  href={selectedProduct.catalogPdf}
                  target="_blank"
                  rel="noreferrer"
                  style={{
                    flex: 1, padding: '12px', borderRadius: '10px', fontWeight: '700', fontSize: '13px',
                    backgroundColor: rangeColor, color: 'white', textAlign: 'center', textDecoration: 'none',
                    display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '6px'
                  }}
                >
                  📄 View Product PDF
                </a>
                <a
                  href={`https://wa.me/917225020180?text=${encodeURIComponent(`Hi! I am interested in *${selectedProduct.name}* (${selectedProduct.range} Range - ${selectedProduct.category}). Please share more details and pricing.`)}`}
                  target="_blank"
                  rel="noreferrer"
                  style={{
                    flex: 1, padding: '12px', borderRadius: '10px', fontWeight: '700', fontSize: '13px',
                    backgroundColor: '#25D366', color: 'white', textAlign: 'center', textDecoration: 'none',
                    display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '6px'
                  }}
                >
                  <MessageCircle size={16} /> Enquire Now
                </a>
              </div>
            </div>
          </div>
        </div>,
        document.body
      )}
    </div>
  );
}
