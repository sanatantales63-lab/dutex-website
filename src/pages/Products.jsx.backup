const RANGE_COLORS = {
  'IMPERIAL': '#0055A5',
  'MONARCH': '#1A6B5A',
  'ELITE': '#C0392B',
  'DUTEX': '#7C4E2B'
};

function useInView(threshold = 0.15) {
  const ref = useRef(null);
  const [inView, setInView] = useState(false);
  useEffect(() => {
    const obs = new IntersectionObserver(([e]) => { if (e.isIntersecting) setInView(true); }, { threshold });
    if (ref.current) obs.observe(ref.current);
    return () => obs.disconnect();
  }, [threshold]);
  return [ref, inView];
}

function ProductCard({ prod, index, onSelect }) {
  const [ref, inView] = useInView();
  const rangeColor = RANGE_COLORS[prod.range] || '#333';

  return (
    <div
      ref={ref}
      onClick={() => onSelect(prod)}
      style={{
        backgroundColor: 'var(--bg-white)',
        borderRadius: '16px',
        overflow: 'hidden',
        boxShadow: '0 4px 20px rgba(0,0,0,0.07)',
        border: '1px solid var(--border-color)',
        display: 'flex',
        flexDirection: 'column',
        cursor: 'pointer',
        opacity: inView ? 1 : 0,
        transform: inView ? 'translateY(0)' : 'translateY(40px)',
        transition: `opacity 0.5s ease ${index * 0.07}s, transform 0.5s ease ${index * 0.07}s, box-shadow 0.3s ease`,
      }}
      className="product-card-hover"
    >
      {/* Product Image */}
      <div style={{ height: '200px', overflow: 'hidden', position: 'relative', background: '#f8f9fa' }}>
        <img
          src={prod.image}
          alt={prod.name}
          style={{ width: '100%', height: '100%', objectFit: 'contain', padding: '12px', transition: 'transform 0.4s ease' }}
          className="product-card-img"
        />
        <span style={{
          position: 'absolute', top: '12px', left: '12px',
          backgroundColor: rangeColor,
          color: 'white', fontSize: '10px', fontWeight: '800',
          padding: '4px 10px', borderRadius: '20px',
          textTransform: 'uppercase', letterSpacing: '1px',
          boxShadow: '0 2px 8px rgba(0,0,0,0.2)'
        }}>
          {prod.range}
        </span>
      </div>

      {/* Body */}
      <div style={{ padding: '20px', flexGrow: 1, display: 'flex', flexDirection: 'column' }}>
        <span style={{ fontSize: '11px', color: 'var(--text-muted)', textTransform: 'uppercase', letterSpacing: '0.5px', fontWeight: '600', marginBottom: '4px' }}>
          {prod.category}
        </span>
        <h3 style={{ fontSize: '16px', marginBottom: '8px', lineHeight: '1.3', color: 'var(--text-dark)' }}>{prod.name}</h3>
        <p style={{ color: 'var(--text-muted)', fontSize: '13px', lineHeight: '1.5', flexGrow: 1, marginBottom: '16px' }}>
          {prod.shortDesc}
        </p>
        <div style={{ display: 'flex', gap: '8px', alignItems: 'center' }}>
          <button
            onClick={(e) => { e.stopPropagation(); onSelect(prod); }}
            style={{
              flex: 1, padding: '10px', borderRadius: '8px',
              fontSize: '13px', fontWeight: '600', cursor: 'pointer',
              backgroundColor: rangeColor, color: 'white',
              border: 'none', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '6px',
              transition: 'opacity 0.2s'
            }}
          >
            <Info size={14} /> View Details
          </button>
          <a
            href={prod.catalogPdf}
            target="_blank"
            rel="noreferrer"
            onClick={(e) => e.stopPropagation()}
            style={{
              padding: '10px 14px', borderRadius: '8px', fontSize: '13px',
              fontWeight: '600', cursor: 'pointer', border: `2px solid ${rangeColor}`,
              color: rangeColor, background: 'transparent', textDecoration: 'none',
              display: 'flex', alignItems: 'center', gap: '4px', whiteSpace: 'nowrap'
            }}
          >
            PDF
          </a>
        </div>
      </div>
    </div>
  );
}

export default function Products() {
  const [activeTab, setActiveTab] = useState('all');
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedProduct, setSelectedProduct] = useState(null);

  // Toggle modal-open class on body
  useEffect(() => {
    if (selectedProduct) {
      document.body.classList.add('modal-open');
    } else {
      document.body.classList.remove('modal-open');
    }
    return () => {
      document.body.classList.remove('modal-open');
    };
  }, [selectedProduct]);

  const TABS = [
    { id: 'all', label: 'All Products' },
    { id: 'interior', label: 'Interior Emulsion' },
    { id: 'exterior', label: 'Exterior Emulsion' },
    { id: 'distemper', label: 'Distemper' },
    { id: 'primer', label: 'Primers' },
    { id: 'texture', label: 'Textures' },
  ];

  const filteredProducts = PRODUCTS.filter(prod => {
    const matchesTab = activeTab === 'all' || prod.category === activeTab;
    const matchesSearch = prod.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
      prod.shortDesc.toLowerCase().includes(searchQuery.toLowerCase()) ||
      prod.range.toLowerCase().includes(searchQuery.toLowerCase());
    return matchesTab && matchesSearch;
  });

  const rangeColor = selectedProduct ? (RANGE_COLORS[selectedProduct.range] || '#333') : '#333';

  return (
    <div className="section-padding animate-fade" style={{ backgroundColor: 'var(--bg-primary)' }}>
      <style>{`
        .product-card-hover:hover {
          box-shadow: 0 12px 40px rgba(0,0,0,0.15) !important;
          transform: translateY(-6px) !important;
        }
        .product-card-hover:hover .product-card-img {
          transform: scale(1.06);
        }
        .tab-btn:hover { opacity: 0.85; }
        .enquire-btn { transition: transform 0.2s, box-shadow 0.2s; }
        .enquire-btn:hover { transform: scale(1.04); box-shadow: 0 6px 20px rgba(0,0,0,0.2); }
        @keyframes fadeScaleIn {
          from { opacity: 0; transform: scale(0.94); }
          to { opacity: 1; transform: scale(1); }
        }
        .modal-animate { animation: fadeScaleIn 0.28s cubic-bezier(0.34,1.56,0.64,1); }
        @media (max-width: 640px) {
          .modal-grid-inner { grid-template-columns: 1fr !important; }
          .modal-img { height: 200px !important; }
        }
      `}</style>

      <div className="container">

        {/* Header */}
        <div className="section-title-wrapper">
          <span className="section-subtitle">Awantika & Aaradhya Group</span>
          <h2 className="section-title">Our <span>Product Range</span></h2>
          <p style={{ color: 'var(--text-muted)', maxWidth: '600px', margin: '12px auto 0', fontSize: '14px' }}>
            Premium Ducon & Dutex paints, emulsions, distempers, textures and primers — built for quality and lasting beauty.
          </p>
        </div>

        {/* Filters Row */}
        <div style={{
          backgroundColor: 'var(--bg-white)', padding: '20px 24px',
          borderRadius: '16px', boxShadow: '0 2px 12px rgba(0,0,0,0.06)',
          border: '1px solid var(--border-color)', marginBottom: '40px',
          display: 'flex', flexWrap: 'wrap', gap: '16px', justifyContent: 'space-between', alignItems: 'center'
        }}>
          <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
            {TABS.map(tab => (
              <button
                key={tab.id}
                className="tab-btn"
                onClick={() => setActiveTab(tab.id)}
                style={{
                  padding: '9px 18px', borderRadius: '20px', fontWeight: '600', fontSize: '13px', cursor: 'pointer',
                  backgroundColor: activeTab === tab.id ? 'var(--primary)' : 'transparent',
                  color: activeTab === tab.id ? 'white' : 'var(--text-dark)',
                  border: activeTab === tab.id ? '2px solid var(--primary)' : '2px solid var(--border-color)',
                  transition: 'all 0.2s'
                }}
              >{tab.label}</button>
            ))}
          </div>
          <div style={{ position: 'relative', width: '100%', maxWidth: '280px' }}>
            <input
              type="text"
              placeholder="Search products..."
              value={searchQuery}
              onChange={e => setSearchQuery(e.target.value)}
              style={{
                width: '100%', padding: '10px 16px 10px 40px',
                borderRadius: '20px', border: '1px solid var(--border-color)',
                fontSize: '13px', backgroundColor: 'var(--bg-primary)',
                outline: 'none', boxSizing: 'border-box'
              }}
            />
            <Search size={16} style={{ position: 'absolute', left: '14px', top: '50%', transform: 'translateY(-50%)', color: 'var(--text-muted)' }} />
          </div>
        </div>

        {/* Product Grid */}
        <div style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fill, minmax(270px, 1fr))',
          gap: '28px'
        }}>
          {filteredProducts.map((prod, i) => (
            <ProductCard key={prod.id} prod={prod} index={i} onSelect={setSelectedProduct} />
          ))}
        </div>

        {/* Empty State */}
        {filteredProducts.length === 0 && (
          <div style={{ textAlign: 'center', padding: '60px 20px' }}>
            <p style={{ color: 'var(--text-muted)', fontSize: '16px' }}>No products found for your search.</p>
          </div>
        )}

        {/* ENQUIRY BANNER */}
